# ==========================================================
# NEXORA AI Classroom Portal - Master Environment Template
# ==========================================================

# PostgreSQL Settings
POSTGRES_DB=nexora_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# FastAPI & Security Settings
JWT_SECRET=super_secret_nexora_jwt_key_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_REQUIRED=false

# AI Services
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Redis & Celery
REDIS_PASSWORD=nexora_redis_secure_pass

# MinIO S3 Storage
MINIO_ROOT_USER=nexora_minio_admin
MINIO_ROOT_PASSWORD=nexora_minio_secure_key_2026

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=nexora_grafana_2026

# Public URLs
FRONTEND_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
