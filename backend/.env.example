# ==========================================================
# NEXORA AI Classroom Portal - Backend Environment Variables
# ==========================================================

# Core Application Settings
ENVIRONMENT=development
PROJECT_NAME="Nexora AI Backend"
API_V1_STR=/api/v1
LOG_LEVEL=INFO

# PostgreSQL Connection (Docker internal host 'postgres')
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/nexora_db

# Security & Authentication
JWT_SECRET=super_secret_nexora_jwt_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_REQUIRED=false

# Google Gemini AI Integration
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Frontend & CORS Configuration
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://frontend:3000"]

# Redis & Celery Task Queue
REDIS_URL=redis://:nexora_redis_secure_pass@redis:6379/0
CELERY_BROKER_URL=redis://:nexora_redis_secure_pass@redis:6379/1
CELERY_RESULT_BACKEND=redis://:nexora_redis_secure_pass@redis:6379/2

# MinIO Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=nexora_minio_admin
MINIO_SECRET_KEY=nexora_minio_secure_key_2026
MINIO_BUCKET_RECORDINGS=recordings
MINIO_BUCKET_DOCUMENTS=documents

# File Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=104857600
